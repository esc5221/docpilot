{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "docpilot",
  "version": "0.1.1",
  "identifier": "dev.docpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "docpilot",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../../sidecar/bundle/sidecar/": "sidecar/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDU1N0M3NUY1M0RDNTQKUldSVTNGTmZ4MWNGMjIzc2JqbGJvV1RFMm5JVWExYVFuNy9sZ0xjeXRwdE9CTjVsZlUyRlI2cTAK",
      "endpoints": [
        "https://github.com/esc5221/docpilot/releases/latest/download/latest.json"
      ]
    }
  }
}
